<ul class="social-icons<%= locals.cls ? ' ' + cls : '' %>">
  <% site.social.forEach(function (s) { %>
  <li><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= site.brandName %> on <%= s.label %> (opens in a new tab)" title="<%= s.label %>">
    <% if (s.icon === 'instagram') { %><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
    <% } else if (s.icon === 'linkedin') { %><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
    <% } else if (s.icon === 'facebook') { %><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="currentColor"><path d="M13.6 22v-8.9h3l.45-3.5H13.6V7.4c0-1 .28-1.7 1.73-1.7h1.84V2.57A24.6 24.6 0 0 0 14.48 2.4c-2.66 0-4.48 1.62-4.48 4.6v2.6H7v3.5h3V22h3.6z"/></svg>
    <% } else { %><%= s.label %><% } %>
  </a></li>
  <% }) %>
</ul>
