<dl class="contact-details">
  <div>
    <dt>Email</dt>
    <dd><a href="mailto:<%= site.email %>"><%= site.email %></a></dd>
  </div>
  <div>
    <dt>Phone</dt>
    <dd><a href="<%= site.phoneHref %>"><%= site.phone %></a></dd>
  </div>
  <div>
    <dt>Social</dt>
    <dd class="contact-social">
      <% site.social.forEach(function (s) { %><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.label %></a><% }) %>
    </dd>
  </div>
</dl>
