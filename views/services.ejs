<%- include('partials/head') %>

<section class="page-hero bg-navy">
  <div class="container stack">
    <p class="eyebrow eyebrow-light">Our services</p>
    <h1 class="h1 measure-h">Hiring, HR and training in one operationally aware partnership.</h1>
    <p class="lead lead-light">We combine structured hiring, HR outsourcing support and workforce development, so you can run the business instead of chasing CVs.</p>
  </div>
</section>

<section class="section">
  <div class="container stack-xl">
    <% site.services.forEach(function (s, i) { %>
      <article id="<%= s.key %>" class="feature<%= i % 2 === 1 ? ' feature-reverse' : '' %>">
        <div class="photo-zoom"><img class="photo photo-feature" src="<%= s.image.src %>" alt="<%= s.image.alt %>" width="<%= s.image.w %>" height="<%= s.image.h %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>"></div>
        <div class="stack">
          <p class="feature-kicker"><%= String(i + 1).padStart(2, '0') %> · <%= s.name %></p>
          <h2 class="h2-sm"><%= s.headline %></h2>
          <p class="muted"><%= s.intro %></p>
          <ul class="ticks">
            <% s.points.forEach(function (p) { %><li><%= p %></li><% }) %>
          </ul>
          <a href="/contact?service=<%= s.key %>#enquiry" class="link-arrow">Discuss your requirements <span aria-hidden="true">→</span></a>
        </div>
      </article>
    <% }) %>

    <div class="panel bg-tint">
      <h2 class="h3">Also available as part of a business partner engagement</h2>
      <ul class="chips">
        <% site.partnerExtras.forEach(function (x) { %><li><%= x %></li><% }) %>
      </ul>
    </div>
  </div>
</section>

<%- include('partials/cta', { heading: 'Pricing is tailored to each engagement.', text: 'After a needs assessment, we send a proposal that fits your objectives and hiring requirements.', button: 'Request a proposal' }) %>

<%- include('partials/foot') %>
