# Copy to .env and fill in. Without SMTP_HOST, enquiries are printed to the console instead of emailed.
PORT=3000

# Public address of the live site, no trailing slash (used for canonical links, social previews and the sitemap)
SITE_URL=

# Set to "production" on the live server (enables long browser caching and HTTPS upgrade)
NODE_ENV=

# SMTP settings for the contact form (e.g. Zoho, Google Workspace, Brevo, Resend SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Who the enquiry email comes from, and where it goes
MAIL_FROM="The Bridge Website <no-reply@yourdomain.com>"
MAIL_TO=thebridgerecruiter@gmail.com
